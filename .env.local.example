# Copy this file to .env.local and fill in real values.
# .env.local is already excluded from Git by .gitignore — never commit real values.

# --- Supabase (public / client-safe) -----------------------------------
# These two values are safe to expose in browser code. The anon key is
# NOT a secret by itself — access to real data is controlled by Row Level
# Security (RLS) policies in the database, not by hiding this key.
# Find both in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, DO NOT expose to the browser) --------------
# Not used yet in this foundation feature. When we add server-side logic
# that needs to bypass RLS (rare, and only in trusted server code), the
# service role key will go here. It must NEVER be prefixed with
# NEXT_PUBLIC_ and must never be imported into any file used by the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-only, DO NOT expose to the browser) --------------
# Used by src/lib/ai/claude.ts - the only file in this codebase that
# reads this variable or imports the Anthropic SDK. Never prefix this
# with NEXT_PUBLIC_, and never import that file from anything that runs
# in the browser. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
